# =============================================================================
#  CIDA 检测服务环境变量模板
#  用法：sudo cp deploy/cida-detect.env /etc/default/cida-detect  然后按需修改
#        （Windows 下可作为系统环境变量，或在启动脚本里 $env:CIDA_PORT="5000"）
# =============================================================================

# ---------- 监听 ----------
# 127.0.0.1 = 只允许本机（推荐：由 nginx 反向代理对外）；0.0.0.0 = 直接对外（须配合防火墙）
CIDA_HOST=127.0.0.1
CIDA_PORT=5000

# ---------- 模型口径（两选一，必须与特征来源匹配）----------
# 场景 A：有独立流量探针 / 能算出完整 CICFlowMeter 特征
CIDA_PROCESSED_DIR=data/processed
CIDA_MODEL_TAG=

# 场景 B：只有 SDN 控制器，字段来自 OpenFlow 流表统计（17 列）
# CIDA_PROCESSED_DIR=data/processed_sdn
# CIDA_MODEL_TAG=sdn_ctrl

# ---------- 检测策略默认值（运行时可用 POST /api/policy 热更新）----------
# observe | throttle | block ；上线首周建议 observe
CIDA_POLICY_ACTION=observe
# 1 = 演练模式（只记录、不改流表），确认无误后改 0
CIDA_DRY_RUN=1
# 判定阈值（0.5 起步；误报超标时按 results/operating_point.md 升到 0.9）
CIDA_THRESHOLD=0.5
# 连续确认窗口数（把误报压到可用区间的关键旋钮，建议 3）
CIDA_CONFIRM_WINDOWS=3
# 永不处置的源 IP（空格分隔）：控制器管理口、网关、监控机、跳板机 —— 上线前必须填
CIDA_WHITELIST=

# 「未知形态」标记阈值（多分类概率熵）：超过它就认为模型没见过这种形态，判定类别显示为 Unknown。
# 0 = 关闭（默认）。先用 python tools/openset_calibrate.py 在**正常流量**上按误报预算标定再填。
# ⚠️ 它只把细分类别换成 Unknown，**不影响是否告警**；语义边界见 results/openset_report.md
CIDA_UNKNOWN_THRESHOLD=0

# 未知形态的保守动作：observe | throttle | block
# 默认 throttle（限速）。硬护栏：未知分支**不允许升级为 block**，即使这里填了也会被降级为 throttle。
# 理由：未知 ≠ 恶意，误封正常业务链路的代价可能高于放行一次可疑流量。
CIDA_UNKNOWN_ACTION=throttle

# 观察池下界比例（0~1）：落在 [该比例×阈值, 阈值) 的未确认窗口进观察池留痕，供漏报复盘。
# 0.5 = 从"打到阈值一半"就开始留痕；设成 1 会让观察池永远为空（静默失效）。
CIDA_OBSERVE_MARGIN=0.5

# ---------- 写接口鉴权（纵深防御）----------
# 设置后，POST /api/policy、POST /api/review、POST /api/review/promote 必须带令牌：
#   curl -H "X-API-Token: <你的令牌>" ...
# 读接口（大屏轮询 /api/*）保持开放，前端不必持令牌。
# 留空 = 完全放行（本地演示/验收自检）。**对外部署时建议设置**：
# DEPLOYMENT.md 的 nginx Basic 认证是第一层，这里再补一层应用级校验，
# 避免反代配置失误或内网可达时，任何人都能关掉演练模式、把建议动作改成真实封禁。
# 生成示例：python -c "import secrets;print(secrets.token_urlsafe(24))"
CIDA_API_TOKEN=

# 审计台账 / 标注回流文件的轮转（单文件字节上限与保留的历史文件数）。
# 这两个文件只追加不删除，长期运行必须轮转，否则会写满磁盘。
CIDA_AUDIT_MAX_BYTES=20000000
CIDA_AUDIT_BACKUPS=3

# 是否把进入研判队列的**窗口特征向量**落盘到 results/review_evidence.jsonl（1=开，默认）。
# 为什么必须开：review_feedback.jsonl 只有结论与分数、没有特征，关掉它人工标完也训不了模型，
# "未知 → 已知"就只是话术。证据与结论按 review_id 关联，可拼成带标签训练样本。
CIDA_REVIEW_EVIDENCE=1

# ---------- 自动放松（自动降级）----------
# 系统此前只会"自动升级"（同源反复告警越报越狠），长期高误报没有自愈路径：
# 复核台里人已经判了一堆 normal，工作点却只能靠人工改。打开这个开关后，服务会按**人工结论**
# 自动把判定阈值上调一档，直到上限为止，并把每次调整写进审计台账。
# ⚠️ 默认 0 = 关。开启前请先确认：① 复核结论确实有人在看（不是随手点"正常"）；
#    ② 阈值上调会让检测变钝，宁可慢一点、也不要无人值守地自动放宽。
CIDA_AUTOTIGHTEN=0
# 触发门槛：人工已给结论至少多少条，才允许据此调整（样本太少不足以代表误报水平）
CIDA_AUTOTIGHTEN_MIN_LABELED=10
# 触发门槛：这些结论里 normal（误报）的占比达到多少才动手；达不到说明不是普遍误报
CIDA_AUTOTIGHTEN_NORMAL_RATIO=0.8
# 每次上调的步长（0.05 = 阈值 0.50 → 0.55）
CIDA_AUTOTIGHTEN_STEP=0.05
# 阈值上限（硬护栏：不允许一路推到 1.0，那等于把检测关掉）
CIDA_AUTOTIGHTEN_MAX=0.9

# ---------- 运行环境 ----------
PYTHONIOENCODING=utf-8
TF_CPP_MIN_LOG_LEVEL=2
