# ============================================================================
#  .gitignore —— 公开仓库只包含团队自主创作、依法有权开放的内容
#  依竞赛规则，以下三类内容不得公开再分发，故一律排除：
#    1) 上游参考素材（未标注许可证）
#    2) 第三方真实数据集（未标注许可证）
#    3) 含本机个人信息/体量过大的环境与产物
# ============================================================================

# ---------- 上游参考素材：未标注许可证，不随作品公开（见 NOTICE）----------
CNN_biLSTM2.py
generate_normal_traffic/
generate_ddos_traffic/

# ---------- 第三方真实数据集：未标注许可证，仅本地评估使用（见 NOTICE）----------
data/real/

# ---------- 运行环境与缓存 ----------
.venv/
.cache/
_tmp/
_piptest/
__pycache__/
*.pyc
.ipynb_checkpoints/

# ---------- 自研数据与产物（可再生成；如需随仓库发布小规模样例，请单独挑选）----------
# data/raw*/ 同时覆盖 data/raw 与困难基准的 data/raw_hard（两者都是可再生的 CSV，各 ~90 MB）
data/raw*/*.csv
data/processed/*.npz
data/processed/*.joblib
data/processed_*/*.npz
data/processed_*/*.joblib
data/raw_smoke/
data/processed_smoke/
data/processed_real*/
artifacts/*/*.keras
artifacts/*/*/*.keras
artifacts/*.weights.h5
artifacts/*/*.weights.h5
artifacts/*/*/*.weights.h5
artifacts/*/*.h5
artifacts/*.npy
artifacts/*/*.npy
artifacts/*/*.joblib
artifacts/*.npz
# 消融实验（ws10/16/24/32/48 及其多种子、困难基准 hard10/16/24/32）的窗口级预测缓存：
# 每个约 450 KB、合计约 47 MB，属可再生的中间产物，且没有任何交付工具会读它们
# （消融报告只读 results/metrics_ws*.json 与 results/metrics_hard*.json）
artifacts/predictions_windows_ws*.csv
artifacts/predictions_ws*.csv
artifacts/predictions_*_hard*.csv
artifacts/predictions_hard*.csv
# 工具自己的子目录产物（如 artifacts/pktseq_control/）里的窗口级预测缓存同样是可再生的
artifacts/*/predictions_*.csv
artifacts/_smoke/
results/_smoke/
# `run_all.py --smoke` 会用 `<tag>_smoke` 后缀把产物写在正式目录里（数据目录已隔离，
# 但 results/artifacts 是共用的）。这些是每次快跑都会重算的验证产物，不进版本库，
# 否则跑一次 `--smoke` 就会把工作区弄脏。
artifacts/*_smoke*
results/*_smoke*
# 各工具的临时/试跑目录（results/_xxx/ 或 results/_xxx.csv，例如校准阶梯与 pcap 抽查的中间产物）
results/_*
results/figures_real*/
results/predictions_cli.csv
results/summary_backup.json
# 运行期告警审计台账：每次运行都会追加，属运行日志（其汇总见 results/e2e_controller_report.md /
# results/live_demo_incident.md）；同目录下的 *.md / *.json 报告才是要交付的产物
results/audit_alerts*.jsonl
results/live_demo_audit*.jsonl
logs/

# ---------- 系统杂项 ----------
.DS_Store
Thumbs.db
# 对标实验（tools/feature_selection.py）的逐次训练产物：可由一条命令重算，
# 汇总结果本身在 results/feature_selection.{json,md}，那是要交付的
artifacts/_featsel/
artifacts/_pub_baselines/

