{
  "run_name": "cnn_bilstm_main",
  "schema": "insdn",
  "source": "synthetic",
  "scale": 1.0,
  "overlap_ratio": 0.15,
  "label_noise": 0.01,
  "feature_noise": 0.05,
  "drift_strength": 0.0,
  "input_mode": "sequence",
  "window_size": 10,
  "window_stride": 5,
  "online_stride": 3,
  "train_ratio": 0.6,
  "val_ratio": 0.15,
  "purge_windows": 2,
  "keep_port_features": false,
  "model_variant": "cnn_bilstm",
  "conv_filters": [64, 128],
  "conv_kernel": 3,
  "lstm_units": 64,
  "dense_units": [128, 64],
  "dropout": 0.3,
  "l2_reg": 0.0001,
  "batch_norm": true,
  "use_attention": true,
  "epochs": 40,
  "batch_size": 256,
  "learning_rate": 0.001,
  "min_learning_rate": 0.00001,
  "lr_patience": 4,
  "early_stop_patience": 8,
  "use_class_weight": true,
  "binary_loss_weight": 0.3,
  "report_threshold": 0.5,
  "figures": true,
  "seed": 42
}
